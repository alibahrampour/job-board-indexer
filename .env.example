# Copy to .env  (cp .env.example .env)
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=jobs

DATABASE_URL=postgresql+psycopg://jobs:jobs@postgres:5432/jobs
REDIS_URL=redis://redis:6379/0

# Required for /api/v1/admin/* (header: X-Admin-Key)
ADMIN_API_KEY=change-me

# Identify yourself to the sources you fetch from
USER_AGENT=JobBoardIndexer/0.1 (+you@example.com)
EXPIRE_AFTER_MISSED_RUNS=3
DEFAULT_SCHEDULE_MINUTES=360
CORS_ORIGINS=http://localhost:3000
